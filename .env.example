# Optional development override for SeasonFetch Desktop backend.
# Leave unset to connect to the production SeasonFetch backend.
# SEASONFETCH_BACKEND_URL=https://season-fetch.vercel.app

# Public Supabase client configuration (publishable key only — never a service-role key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
