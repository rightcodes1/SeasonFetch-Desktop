{
  "name": "seasonfetch-desktop",
  "productName": "SeasonFetch",
  "version": "0.1.1-beta.7",
  "author": "SeasonFetch",
  "description": "Dedicated Windows desktop client for SeasonFetch.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:renderer": "node ./node_modules/vite/bin/vite.js",
    "dev": "node scripts/dev.mjs",
    "build:renderer": "node ./node_modules/vite/bin/vite.js build",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "release:check": "node scripts/release-check.mjs",
    "dist:dir": "npm run build:renderer && electron-builder --win --dir",
    "dist:win": "npm run release:check && npm run build:renderer && electron-builder --win nsis",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.81.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "app.seasonfetch.desktop",
    "productName": "SeasonFetch",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "SeasonFetch-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SeasonFetch",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rightcodes1",
        "repo": "SeasonFetch-Desktop-Releases",
        "private": false,
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
